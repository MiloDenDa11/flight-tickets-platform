NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://flight_user:replace_password@localhost:5434/flight_tickets_db?schema=public
REDIS_URL=redis://localhost:6381
FRONTEND_URL=http://localhost:5174
JWT_ACCESS_SECRET=replace_with_random_secret_at_least_32_characters
HOLD_MINUTES=15
ENABLE_MOCK_PAYMENTS=true
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Flight Tickets <noreply@example.com>

# Optional partner JSON feeds: HTTPS, server-side bearer token, no scraping.
FLIGHT_PROVIDER_NAME=PARTNER_FEED
FLIGHT_SCHEDULE_URL=
FLIGHT_STATUS_URL=
FLIGHT_FARES_URL=
FLIGHT_PROVIDER_API_KEY=
FLIGHT_PROVIDER_TIMEOUT_MS=10000
FLIGHT_SYNC_ENABLED=false
FLIGHT_SYNC_INTERVAL_SECONDS=300
